<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WhiteNet" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_gradient</item>
        <item name="android:statusBarColor">@color/bg_deep</item>
        <item name="android:navigationBarColor">@color/bg_deep</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="colorAccent">@color/accent_a</item>
    </style>

    <style name="Caption">
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="Card">
        <item name="android:background">@drawable/card_bg</item>
        <item name="android:padding">16dp</item>
    </style>
</resources>
