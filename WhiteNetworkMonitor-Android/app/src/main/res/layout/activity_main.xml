<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="@string/app_name"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text_main"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/subtitle"
                    android:textColor="@color/text_dim"
                    android:textSize="9sp"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/segContainer"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/seg_container"
            android:orientation="horizontal"
            android:padding="5dp">

            <TextView
                android:id="@+id/tabNet"
                style="@style/Caption"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/seg_tab"
                android:gravity="center"
                android:text="@string/tab_net"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_main"/>

            <TextView
                android:id="@+id/tabSys"
                style="@style/Caption"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/seg_tab"
                android:gravity="center"
                android:text="@string/tab_sys"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_dim"/>

            <TextView
                android:id="@+id/tabSet"
                style="@style/Caption"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/seg_tab"
                android:gravity="center"
                android:text="@string/tab_set"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_dim"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/panelNet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <LinearLayout style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <FrameLayout
                    android:id="@+id/dotWrap"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:id="@+id/dotFail"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:src="@drawable/dot_red"
                        android:contentDescription="@null"/>
                    <ImageView
                        android:id="@+id/dotOk"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:src="@drawable/dot_green"
                        android:visibility="invisible"
                        android:contentDescription="@null"/>
                </FrameLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/statusTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/st_check"
                        android:textColor="@color/text_main"
                        android:textSize="19sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/statusHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/net_hint_on"
                        android:textColor="@color/text_dim"
                        android:textSize="11.5sp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical">
                <TextView android:id="@+id/ipCaption" style="@style/Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ip_cap"/>
                <TextView
                    android:id="@+id/ipValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="monospace"
                    android:text="—"
                    android:textColor="@color/text_main"
                    android:textSize="20sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout style="@style/Card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/dlCaption" style="@style/Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/dl_cap"/>
                    <TextView
                        android:id="@+id/speedDown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="monospace"
                        android:text="0 B/s"
                        android:textColor="@color/text_main"
                        android:textSize="17sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/sp_sub"
                        android:textColor="@color/text_dim"
                        android:textSize="10sp"/>
                </LinearLayout>

                <LinearLayout style="@style/Card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/ulCaption" style="@style/Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ul_cap"/>
                    <TextView
                        android:id="@+id/speedUp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="monospace"
                        android:text="0 B/s"
                        android:textColor="@color/text_main"
                        android:textSize="17sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/sp_sub"
                        android:textColor="@color/text_dim"
                        android:textSize="10sp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:id="@+id/pingCaption" style="@style/Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/p_cap"/>
                    <TextView
                        android:id="@+id/pingValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="monospace"
                        android:text="@string/p_hint"
                        android:textColor="@color/text_main"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/btnPing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_accent"
                    android:paddingLeft="18dp"
                    android:paddingRight="18dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="@string/btn_check"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/panelSys"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/ramCaption" style="@style/Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ram_cap"/>
                <ProgressBar
                    android:id="@+id/ramBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_marginTop="10dp"
                    android:max="100"
                    android:progressDrawable="@drawable/bar_violet"/>
                <TextView
                    android:id="@+id/ramDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="…"
                    android:textColor="@color/text_dim"
                    android:textSize="11.5sp"/>
            </LinearLayout>

            <LinearLayout style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical">
                <TextView android:id="@+id/diskCaption" style="@style/Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/disk_cap"/>
                <ProgressBar
                    android:id="@+id/diskBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_marginTop="10dp"
                    android:max="100"
                    android:progressDrawable="@drawable/bar_violet"/>
                <TextView
                    android:id="@+id/diskDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="…"
                    android:textColor="@color/text_dim"
                    android:textSize="11.5sp"/>
            </LinearLayout>

            <LinearLayout style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical">
                <TextView android:id="@+id/batCaption" style="@style/Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/bat_cap"/>
                <ProgressBar
                    android:id="@+id/batBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_marginTop="10dp"
                    android:max="100"
                    android:progressDrawable="@drawable/bar_violet"/>
                <TextView
                    android:id="@+id/batDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="…"
                    android:textColor="@color/text_dim"
                    android:textSize="11.5sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout style="@style/Card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/osCaption" style="@style/Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/os_cap"/>
                    <TextView
                        android:id="@+id/osValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Android"
                        android:textColor="@color/text_main"
                        android:textSize="13.5sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout style="@style/Card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/upCaption" style="@style/Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/up_cap"/>
                    <TextView
                        android:id="@+id/uptimeValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="—"
                        android:textColor="@color/text_main"
                        android:textSize="13.5sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/panelSet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView style="@style/Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/set_lang"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/langRu"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/card_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <View
                            android:layout_width="26dp"
                            android:layout_height="17dp"
                            android:background="@drawable/flag_ru"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="11dp"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Русский"
                                android:textColor="@color/text_main"
                                android:textSize="14sp"
                                android:textStyle="bold"/>
                            <TextView android:id="@+id/langRuSub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/lang_ru_sub" android:textColor="@color/text_dim" android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/langEn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/card_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <View
                            android:layout_width="26dp"
                            android:layout_height="17dp"
                            android:background="@drawable/flag_en"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="11dp"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="English"
                                android:textColor="@color/text_main"
                                android:textSize="14sp"
                                android:textStyle="bold"/>
                            <TextView android:id="@+id/langEnSub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/lang_en_sub" android:textColor="@color/text_dim" android:textSize="10sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:text="@string/set_note"
                    android:textColor="@color/text_dim"
                    android:textSize="10.5sp"/>
            </LinearLayout>

            <LinearLayout style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical">
                <TextView style="@style/Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/about_cap"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="@string/app_name"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/about_l2"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/btnDonate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_donate"
                android:gravity="center"
                android:padding="14dp"
                android:text="@string/donate_btn"
                android:textColor="@color/donate_text"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/btnTelegram"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_accent"
                android:gravity="center"
                android:padding="14dp"
                android:text="@string/tg_btn"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
