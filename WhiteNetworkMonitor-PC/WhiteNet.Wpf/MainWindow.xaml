<Window x:Class="WhiteNet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="White Network Monitor"
        Width="560" Height="700"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" ShowInTaskbar="True">

    <Window.Resources>
        <Style x:Key="DonateBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#2B2B2B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8" Background="#F5B301"
                                Padding="0,12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LangCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="10"
                                Background="#26262C" BorderThickness="1"
                                BorderBrush="#3A3A44" Padding="14,11">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#FF2B477F"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background" Value="#31323A"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Border CornerRadius="12"
                BorderBrush="#FF3A3A44" BorderThickness="1"
                Background="{StaticResource BrushWindowBg}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="52"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="Transparent"
                      MouseLeftButtonDown="TitleBar_Drag">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0" Width="11" Height="11"
                             Margin="20,0,10,0" VerticalAlignment="Center"
                             Fill="{StaticResource BrushAccent}"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="White Network Monitor"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTitleText}"/>
                        <TextBlock Text="WHITE TEAM · NETWORK SUITE"
                                   FontSize="9" Margin="1,3,0,0"
                                   Foreground="#9AA0A6"/>
                    </StackPanel>

                    <Button Grid.Column="2" Style="{StaticResource GhostBtn}"
                            Content="—" Click="BtnMin_Click"/>
                    <Button Grid.Column="3" Style="{StaticResource GhostBtn}"
                            Content="✕" Click="BtnClose_Click"/>
                </Grid>

                <Grid Grid.Row="1" Margin="22,2,22,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" CornerRadius="14"
                            Background="#26000000" Padding="5">
                        <UniformGrid Columns="3">
                            <RadioButton x:Name="TabNet" Style="{StaticResource SegTab}"
                                         GroupName="tabs" IsChecked="True"
                                         Content="🌐  Сеть"/>
                            <RadioButton x:Name="TabSys" Style="{StaticResource SegTab}"
                                         GroupName="tabs" Content="📊  Система"/>
                            <RadioButton x:Name="TabSet" Style="{StaticResource SegTab}"
                                         GroupName="tabs" Content="⚙  Настройки"/>
                        </UniformGrid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden"
                                  Margin="0,14,0,4">
                        <StackPanel>

                            <Grid x:Name="PanelNet">
                                <StackPanel>

                                    <Border Style="{StaticResource Card}" Padding="18,16">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid x:Name="DotWrap" Background="Transparent"
                                                  Cursor="Hand"
                                                  MouseLeftButtonDown="Dot_Click">
                                                <Ellipse x:Name="DotOk" Width="46" Height="46"
                                                     Fill="{StaticResource BrushGreen}"
                                                     Visibility="Hidden"/>
                                                <Ellipse x:Name="DotFail" Width="46" Height="46"
                                                         Fill="{StaticResource BrushRed}"/>
                                            </Grid>
                                            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="StatusBig" Text="Проверка…"
                                                           FontSize="20" FontWeight="Bold"
                                                           Foreground="{StaticResource BrushText}"/>
                                                <TextBlock x:Name="StatusSub"
                                                           Text="Подключение проверяется каждые 5 сек"
                                                           Style="{StaticResource SubDim}" Margin="1,4,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock x:Name="IpCaption" Text="ЛОКАЛЬНЫЙ IP-АДРЕС"
                                                       Style="{StaticResource Caption}"/>
                                            <TextBlock x:Name="IpValue" Text="—"
                                                       Style="{StaticResource ValBig}"
                                                       FontFamily="Consolas" Margin="1,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <UniformGrid Columns="2" Margin="0,12,0,0">
                                        <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock x:Name="DlCaption" Text="ЗАГРУЗКА ↓"
                                                           Style="{StaticResource Caption}"/>
                                                <TextBlock x:Name="SpeedDown" Text="0 Б/с"
                                                           Style="{StaticResource ValBig}"
                                                           FontFamily="Consolas" Margin="1,6,0,0"/>
                                                <TextBlock x:Name="DlSub" Text="реальная скорость интерфейсов"
                                                           Style="{StaticResource SubDim}" Margin="1,6,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Card}" Padding="18,14" Margin="6,0,0,0">
                                            <StackPanel>
                                                <TextBlock x:Name="UlCaption" Text="ОТДАЧА ↑"
                                                           Style="{StaticResource Caption}"/>
                                                <TextBlock x:Name="SpeedUp" Text="0 Б/с"
                                                           Style="{StaticResource ValBig}"
                                                           FontFamily="Consolas" Margin="1,6,0,0"/>
                                                <TextBlock x:Name="UlSub" Text="реальная скорость интерфейсов"
                                                           Style="{StaticResource SubDim}" Margin="1,6,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,12,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock x:Name="PingCaption" Text="ПИНГ ДО 8.8.8.8"
                                                           Style="{StaticResource Caption}"/>
                                                <TextBlock x:Name="PingValue" Text="нажми «Проверить»"
                                                           Style="{StaticResource ValBig}"
                                                           FontFamily="Consolas" Margin="1,6,0,0"/>
                                            </StackPanel>
                                            <Button x:Name="PingBtn" Grid.Column="1"
                                                    Style="{StaticResource GradBtn}"
                                                    Content="⟳  Проверить" Click="PingBtn_Click"/>
                                        </Grid>
                                    </Border>

                                </StackPanel>
                            </Grid>

                            <Grid x:Name="PanelSys" Visibility="Collapsed">
                                <StackPanel>

                                    <Border Style="{StaticResource Card}" Padding="18,14">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock x:Name="CpuCaption" Text="ПРОЦЕССОР"
                                                           Style="{StaticResource Caption}"/>
                                                <TextBlock x:Name="CpuPct" Text="0%"
                                                           HorizontalAlignment="Right"
                                                           Style="{StaticResource ValBig}" FontSize="17"/>
                                            </Grid>
                                            <ProgressBar x:Name="CpuBar" Style="{StaticResource VioletBar}"
                                                         Minimum="0" Maximum="100" Margin="0,10,0,0"/>
                                            <TextBlock x:Name="CpuDetail" Text="…"
                                                       Style="{StaticResource SubDim}" Margin="1,7,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,12,0,0">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock x:Name="RamCaption" Text="ОПЕРАТИВНАЯ ПАМЯТЬ"
                                                           Style="{StaticResource Caption}"/>
                                                <TextBlock x:Name="RamPct" Text="0%"
                                                           HorizontalAlignment="Right"
                                                           Style="{StaticResource ValBig}" FontSize="17"/>
                                            </Grid>
                                            <ProgressBar x:Name="RamBar" Style="{StaticResource VioletBar}"
                                                         Minimum="0" Maximum="100" Margin="0,10,0,0"/>
                                            <TextBlock x:Name="RamDetail" Text="…"
                                                       Style="{StaticResource SubDim}" Margin="1,7,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,12,0,0">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock x:Name="DiskCaption" Text="ДИСК C:"
                                                           Style="{StaticResource Caption}"/>
                                                <TextBlock x:Name="DiskPct" Text="0%"
                                                           HorizontalAlignment="Right"
                                                           Style="{StaticResource ValBig}" FontSize="17"/>
                                            </Grid>
                                            <ProgressBar x:Name="DiskBar" Style="{StaticResource VioletBar}"
                                                         Minimum="0" Maximum="100" Margin="0,10,0,0"/>
                                            <TextBlock x:Name="DiskDetail" Text="…"
                                                       Style="{StaticResource SubDim}" Margin="1,7,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <UniformGrid Columns="2" Margin="0,12,0,0">
                                        <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock x:Name="OsCaption" Text="СИСТЕМА"
                                                           Style="{StaticResource Caption}"/>
                                                <TextBlock x:Name="OsValue" Text="Windows"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{StaticResource BrushText}"
                                                           Margin="1,5,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Card}" Padding="16,13" Margin="6,0,0,0">
                                            <StackPanel>
                                                <TextBlock x:Name="UpCaption" Text="ВРЕМЯ РАБОТЫ"
                                                           Style="{StaticResource Caption}"/>
                                                <TextBlock x:Name="UptimeValue" Text="—"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{StaticResource BrushText}"
                                                           Margin="1,5,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                </StackPanel>
                            </Grid>

                            <Grid x:Name="PanelSet" Visibility="Collapsed">
                                <StackPanel>

                                    <Border Style="{StaticResource Card}" Padding="18,16">
                                        <StackPanel>
                                            <TextBlock x:Name="LangCaption" Text="ЯЗЫК"
                                                       Style="{StaticResource Caption}"/>

                                            <UniformGrid Columns="2" Margin="0,12,0,0">
                                                <RadioButton x:Name="LangRu" Style="{StaticResource LangCard}"
                                                             GroupName="lang" Margin="0,0,6,0"
                                                             Checked="LangRu_Checked">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="26" Height="17" CornerRadius="3"
                                                                ClipToBounds="True"
                                                                BorderBrush="#55FFFFFF" BorderThickness="1">
                                                            <StackPanel>
                                                                <Border Background="#FFFFFF"/>
                                                                <Border Background="#0039A6"/>
                                                                <Border Background="#D52B1E"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="Русский" FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource BrushText}"/>
                                                            <TextBlock x:Name="LangRuSub" Text="Русский язык"
                                                                       Style="{StaticResource SubDim}"
                                                                       FontSize="10" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </RadioButton>

                                                <RadioButton x:Name="LangEn" Style="{StaticResource LangCard}"
                                                             GroupName="lang" Margin="6,0,0,0"
                                                             Checked="LangEn_Checked">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="26" Height="17" CornerRadius="3"
                                                                ClipToBounds="True"
                                                                BorderBrush="#55FFFFFF" BorderThickness="1"
                                                                Background="#012169">
                                                            <Grid>
                                                                <Rectangle Fill="#FFFFFF" Height="3.2"
                                                                           VerticalAlignment="Center"
                                                                           RenderTransformOrigin="0.5,0.5">
                                                                    <Rectangle.RenderTransform>
                                                                        <RotateTransform Angle="-33"/>
                                                                    </Rectangle.RenderTransform>
                                                                </Rectangle>
                                                                <Rectangle Fill="#FFFFFF" Height="3.2"
                                                                           VerticalAlignment="Center"
                                                                           RenderTransformOrigin="0.5,0.5">
                                                                    <Rectangle.RenderTransform>
                                                                        <RotateTransform Angle="33"/>
                                                                    </Rectangle.RenderTransform>
                                                                </Rectangle>
                                                                <Rectangle Fill="#FFFFFF" Width="9"
                                                                           HorizontalAlignment="Center"/>
                                                                <Rectangle Fill="#FFFFFF" Height="9"
                                                                           VerticalAlignment="Center"/>
                                                                <Rectangle Fill="#C8102E" Width="5.2"
                                                                           HorizontalAlignment="Center"/>
                                                                <Rectangle Fill="#C8102E" Height="5.2"
                                                                           VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="English" FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource BrushText}"/>
                                                            <TextBlock x:Name="LangEnSub" Text="Английский язык"
                                                                       Style="{StaticResource SubDim}"
                                                                       FontSize="10" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </RadioButton>
                                            </UniformGrid>

                                            <TextBlock x:Name="LangNote"
                                                       Text="Применяется мгновенно и запоминается в системе"
                                                       Style="{StaticResource SubDim}" Margin="1,11,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Padding="18,15" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock x:Name="AboutCaption" Text="О ПРОГРАММЕ"
                                                       Style="{StaticResource Caption}"/>
                                            <TextBlock Text="White Network Monitor v2.0 · WPF"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrushText}"
                                                       Margin="1,7,0,0"/>
                                            <TextBlock x:Name="AboutLine2"
                                                       Text="Сделано White Team · .NET Framework 4.7.2"
                                                       Style="{StaticResource SubDim}" Margin="1,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Button x:Name="DonateBtn"
                                            Style="{StaticResource DonateBtn}"
                                            Margin="0,12,0,0"
                                            Content="❤  Пожертвования (Поддержка)"
                                            Click="DonateBtn_Click"/>

                                </StackPanel>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid Grid.Row="2" Margin="24,0,24,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="StartupCheck" Grid.Column="0"
                              Content="Запускать с Windows" VerticalAlignment="Center"
                              Foreground="{StaticResource BrushDim}" FontSize="12"
                              Checked="Startup_Changed" Unchecked="Startup_Changed"/>
                    <TextBlock Grid.Column="1" Text="v2.0 · White Team"
                           VerticalAlignment="Center" FontSize="11"
                           Foreground="#9AA0A6"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
